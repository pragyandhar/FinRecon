# Copy to .env and fill in OPENAI_API_KEY.
#
# OPENAI_MODEL is the single place that controls which model every AI
# stage uses (schema understanding, canonical mapping, planning,
# exception investigation, chat). Change it here only.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage
DATABASE_URL=sqlite:///./backend/storage/finrecon.db
RAW_STORAGE_DIR=./backend/storage/raw

# Limits / behavior
MAX_FILE_SIZE_MB=25
MAX_PLAN_RETRIES=2
DEFAULT_AMOUNT_TOLERANCE=1.0
ENABLE_LLM_FALLBACK=true
ENABLE_CHAT=true

# Guardrails: refuse a JOIN on a field that isn't actually a per-record
# identifier (checked on the key's own uniqueness BEFORE merging, and
# again on the output size as a backstop), and cap how many exceptions
# one job will ever send to the AI investigator.
MIN_JOIN_KEY_UNIQUENESS=0.5
MAX_JOIN_OUTPUT_ROWS=20000
MAX_JOIN_OUTPUT_MULTIPLIER=10
MAX_EXCEPTIONS_TO_INVESTIGATE=200

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
